<Window x:Class="ProcessControlSimulatorOpcUa.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProcessControlSimulatorOpcUa"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button Content="Button" HorizontalAlignment="Left" Margin="153,185,0,0" VerticalAlignment="Top" Click="StartOpcUa_Click"/>
        <Button Content="Button" HorizontalAlignment="Left" Margin="309,217,0,0" VerticalAlignment="Top" Click="Button_Click"/>

        <StackPanel Margin="20">

            <TextBlock Text="Lot ID" />

            <TextBox x:Name="LotIdTextBox"
             Width="200"
             Margin="0,5,0,15" />

            <CheckBox x:Name="CommCheckBox"
              Content="Host Comm Check" />

        </StackPanel>

    </Grid>
</Window>
